rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Fields: title, script, genre, voice, language, playbackRate, ownerId, createdAt, updatedAt
    //
    // Collection: projects/{projectId}/characters
    // Fields: name, role, description, image
    //
    // Collection: projects/{projectId}/environments
    // Fields: name, mood, colors, image
    //
    // Collection: projects/{projectId}/frames
    // Fields: title, timeRange, image, prompt, scriptSegment, audioData, characterId, environmentId, shotType, order, directorsBrief
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "IbrahimY437@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProject(data) {
      return hasRequiredFields(['title', 'ownerId', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.ownerId is string &&
             data.createdAt is string; // ISO string
    }

    function isValidCharacter(data) {
      return hasRequiredFields(['name', 'image']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.image is string && data.image.size() < 2000000; // Allow base64 but limit size
    }

    function isValidEnvironment(data) {
      return hasRequiredFields(['name', 'image']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.image is string && data.image.size() < 2000000;
    }

    function isValidFrame(data) {
      return hasRequiredFields(['title', 'order']) &&
             data.title is string &&
             data.order is int;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidProject(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()) && isValidProject(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /characters/{characterId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()) && (request.method == 'DELETE' || isValidCharacter(request.resource.data));
      }

      match /environments/{environmentId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()) && (request.method == 'DELETE' || isValidEnvironment(request.resource.data));
      }

      match /frames/{frameId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()) && (request.method == 'DELETE' || isValidFrame(request.resource.data));
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
